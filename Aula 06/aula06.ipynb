    "s + stack()\n",
    "while x > 0:\n",
    "    q = x // 2\n",
    "    r = x % 2\n",
    "    s.push(r)\n",
    "    x = q\n",
    "resultado = \" \"\n",
    "while not s.empty():\n",
    "    resultado = resultado + str(s.pop)\n",
    "return resultado"
   ]
